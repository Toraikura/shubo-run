    "@types/node": "22.19.19",
    "@vitejs/plugin-react": "6.0.2",
    "vite": "8.0.16",
    "typescript": "5.9.3",
    "vitest": "5.0.0",
    "@playwright/test": "1.63.0",
    "oxlint": "1.76.0"
  }
